{
  "name": "ayu-dawn",
  "displayName": "Ayu Dawn",
  "description": "Ayu Mirage with a slightly paler background and brighter application text and icons, which I find easier on my eyes.",
  "version": "1.0.1",
  "publisher": "GregPasquariello",
  "author": "Greg Pasquariello",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gpasq/vscode-ayu-dawn"
  },
  "bugs": {
    "url": "https://github.com/gpasq/vscode-ayu-dawn/issues"
  },
  "engines": {
    "vscode": "^1.63.0",
    "node": ">=22.18.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "dark",
    "dark-theme",
    "ayu",
    "ayu-mirage",
    "mirage",
    "low-contrast",
    "easy-on-the-eyes",
    "icon-theme"
  ],
  "homepage": "https://github.com/gpasq/vscode-ayu-dawn",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#242735",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "id": "Ayu Dawn Mirage Bordered",
        "label": "Ayu Dawn Mirage",
        "uiTheme": "vs-dark",
        "path": "./ayu-dawn-mirage.json"
      },
      {
        "id": "Ayu Dawn Mirage",
        "label": "Ayu Dawn Mirage Unbordered",
        "uiTheme": "vs-dark",
        "path": "./ayu-dawn-mirage-unbordered.json"
      },
      {
        "id": "Ayu Dawn Light Bordered",
        "label": "Ayu Dawn Light",
        "uiTheme": "vs",
        "path": "./ayu-dawn-light.json"
      },
      {
        "id": "Ayu Dawn Light",
        "label": "Ayu Dawn Light Unbordered",
        "uiTheme": "vs",
        "path": "./ayu-dawn-light-unbordered.json"
      }
    ],
    "iconThemes": [
      {
        "id": "ayu-dawn",
        "label": "Ayu Dawn",
        "path": "./ayu-dawn-icons.json"
      }
    ]
  },
  "scripts": {
    "start": "tsx watch --include ./colors ./src/build.ts",
    "build": "tsx ./src/build.ts && vsce package",
    "test": "tsx --test src/*.test.ts",
    "colors": "tsx ./src/coverage.ts"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.0",
    "@vscode/vsce": "^4.0.0",
    "culori": "^4.0.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
